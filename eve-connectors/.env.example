# Copy to .env.local on the TARX box (never commit). Loaded with: set -a; . ./.env.local; set +a
PORT=3000
NGROK_DOMAIN=                       # your static ngrok domain, e.g. your-name.ngrok-free.app
TARX_DEDUPE_DB=.data/tarx-dedupe.sqlite

# Model: local OpenAI-compatible endpoint on this host (no tunnel)
TARX_MODEL_BASE_URL=http://127.0.0.1:<port>/v1
TARX_MODEL_ID=
TARX_MODEL_API_KEY=
TARX_MODEL_CONTEXT_TOKENS=32768

# Email (Resend) - same variable names TARX already uses
RESEND_API_KEY=                     # full-access key (fetching received mail needs read)
TARX_EMAIL_FROM=                    # address on a Resend-verified domain; bare "a@example.com" becomes "TARX <a@example.com>"
RESEND_WEBHOOK_SECRET=              # whsec_... of the NEW email.received webhook pointing at <ngrok>/connectors/email-resend/inbound
TARX_EMAIL_ALLOW_FROM=owner@example.com
TARX_EMAIL_REPLY_TO=                # e.g. agent@in.example.com: an address on your Resend receiving subdomain
TARX_EMAIL_INBOUND_DOMAIN=          # e.g. in.example.com (MX -> Resend); inbound to other domains is ignored

# Slack (own app; see slack-app-manifest.yaml)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
TARX_SLACK_ALLOW_USERS=U00000000

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000002
TARX_SMS_ALLOW_FROM=+15550000001
TWILIO_WEBHOOK_URL=https://YOUR-NGROK-DOMAIN/eve/v1/twilio/messages
