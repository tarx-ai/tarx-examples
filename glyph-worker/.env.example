# Required. Vercel AI Gateway key (create in Vercel → AI Gateway → API keys). Never commit it.
AI_GATEWAY_API_KEY=
# Or point at a file that holds the key (chmod 600) instead of putting it in env:
# AI_GATEWAY_API_KEY_FILE=~/.config/glyph-worker/ai_gateway_key

# Optional
GLYPH_MODEL=stealth/glyph-cluster
GLYPH_BASE_URL=https://ai-gateway.vercel.sh/v1
GLYPH_CONCURRENCY=4
GLYPH_REASONING=medium            # low | medium | high | xhigh
GLYPH_RUNS_DIR=./runs             # JSONL logs + artifacts (git-ignored)
GLYPH_SPEND_GUARD=strict          # strict: abort if the team's AI Gateway total_used moves during a run; off: skip
GLYPH_PUBLIC_ROOT=..              # repo root that file paths are resolved against
GLYPH_PUBLIC_PATHS=eve-connectors/,glyph-worker/,examples/,src/,test/,docs/,README.md
GLYPH_ALLOWED_LOCAL_PORTS=0,3000  # localhost ports allowed in prompts (public docs mention :3000)
GLYPH_DENY_TERMS=                 # extra private terms to block, comma-separated (keep this in your private env)
