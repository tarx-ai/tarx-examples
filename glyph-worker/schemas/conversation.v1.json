{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tarx.conversation.v1",
  "title": "Synthetic conversational-turn record (SMS / Slack / email) for connector tests and turn-quality evals",
  "type": "object",
  "required": ["schema", "id", "channel", "scenario", "edge_cases", "turns", "expected"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "tarx.conversation.v1" },
    "id": { "type": "string", "pattern": "^(sms|slack|email)-[0-9a-f]{10}$" },
    "channel": { "enum": ["sms", "slack", "email"] },
    "scenario": { "type": "string", "minLength": 8, "maxLength": 200 },
    "edge_cases": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["none", "duplicate_delivery", "opt_out", "help_keyword", "opt_in_resume", "threading", "long_context", "non_allowlisted_sender", "unicode_emoji", "multi_segment", "rapid_fire", "out_of_order", "media_only", "approval_prompt", "provider_error_retry", "ambiguous_request"] }
    },
    "turns": {
      "type": "array", "minItems": 2, "maxItems": 40,
      "items": {
        "type": "object", "required": ["role", "text", "t_offset_s"], "additionalProperties": false,
        "properties": {
          "role": { "enum": ["user", "assistant", "system_event"] },
          "text": { "type": "string", "maxLength": 4000 },
          "t_offset_s": { "type": "number", "minimum": 0 },
          "provider_message_id": { "type": "string", "maxLength": 64 },
          "thread": { "type": "string", "maxLength": 64 },
          "duplicate_of": { "type": "string", "maxLength": 64 },
          "sender": { "enum": ["owner", "unknown"] }
        }
      }
    },
    "expected": {
      "type": "object", "required": ["agent_should", "reply_count"], "additionalProperties": false,
      "properties": {
        "agent_should": { "type": "string", "minLength": 8, "maxLength": 400 },
        "reply_count": { "type": "integer", "minimum": 0, "maximum": 40 },
        "must_not": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 8 }
      }
    }
  }
}
